{
  "name": "netlify-dns-manager",
  "version": "0.4.0",
  "description": "A TypeScript SDK that provides a command line interface and programmatic API to manage DNS records of a domain hosted on Netlify.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "netlify-dns-manage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "netlify",
    "dns",
    "domain",
    "cli",
    "typescript",
    "sdk"
  ],
  "author": "Netlify DNS Manager",
  "license": "MIT",
  "homepage": "https://github.com/sumansaurabh/netlify-dns-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumansaurabh/netlify-dns-manager.git"
  },
  "bugs": {
    "url": "https://github.com/sumansaurabh/netlify-dns-manager/issues"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "dns-zonefile": "^0.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}